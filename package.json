{
  "name": "@mohantn/task-runner",
  "version": "0.1.1",
  "type": "module",
  "description": "Self-hosted AI task scheduler — schedule and run Claude Code / Copilot jobs across multiple repos from a web dashboard.",
  "keywords": [
    "task-runner",
    "ai",
    "claude-code",
    "github-copilot",
    "cron",
    "scheduler",
    "wsl2",
    "windows-terminal"
  ],
  "homepage": "https://github.com/MohanTn/task_runner#readme",
  "bugs": {
    "url": "https://github.com/MohanTn/task_runner/issues"
  },
  "license": "MIT",
  "author": "Mohan Talkad Nagaraju",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohanTn/task_runner.git"
  },
  "main": "dist/index.js",
  "bin": {
    "task-runner": "dist/cli-entry.js",
    "tr": "dist/cli-entry.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "tsc && vite build --config vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"try{require('./scripts/postinstall.cjs')}catch(e){}\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "better-sqlite3": "^11.8.1",
    "cron": "^4.3.0",
    "express": "^5.1.0",
    "lucide-react": "^1.16.0",
    "tailwindcss": "^4.3.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cron": "^2.4.0",
    "@types/express": "^5.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
